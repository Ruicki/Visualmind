# URL pública de la tienda (para vistas previas al compartir). En Vercel se detecta sola.
VITE_SITE_URL=

# URL base del API backend (debe terminar en /api). Obligatoria en producción (Vercel).
# En desarrollo puedes dejarla vacía: Vite hace proxy de /api a localhost:5000.
VITE_API_URL=http://localhost:5000/api

# --- Datos de cobro (pago manual). Si una variable queda vacía, no se muestra. ---
# WhatsApp de la tienda (para recibir comprobantes). Por defecto: +50763148640
VITE_WHATSAPP_NUMBER=
# Número o nombre en el directorio Yappy
VITE_YAPPY_NUMBER=
# Transferencia bancaria (ACH)
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_TYPE=
VITE_BANK_ACCOUNT=
VITE_BANK_HOLDER=

# --- Redes sociales (vacío = oculto). Instagram y Facebook tienen valor por defecto. ---
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TIKTOK_URL=

# --- Publicidad (opcional) ---
# ID del píxel de Meta (Administrador de eventos). Vacío = sin seguimiento.
VITE_META_PIXEL_ID=
