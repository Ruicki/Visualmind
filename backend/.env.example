# --- CONFIGURACIÓN DEL SERVIDOR ---
PORT=5000
# En Railway/Render usa: production
NODE_ENV=development

# --- BASE DE DATOS (POSTGRESQL) ---
# Opción 1: URL directa (Recomendado para Railway/Render)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Opción 2: Parámetros individuales (Local)
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visualmind

# --- SEGURIDAD ---
# Cadena aleatoria de 32+ caracteres para firmar las sesiones (obligatoria en producción).
# Genérala con: openssl rand -hex 32
JWT_SECRET=

# --- ADMINISTRADOR ---
# Obligatorio en producción la primera vez (y para recuperar el acceso).
# Si solo defines ADMIN_PASSWORD, se aplica a visualmind@admin.com.
# Al arrancar, el servidor crea/actualiza este admin. Usa una contraseña fuerte.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- PRECIOS (opcionales) ---
# Envío gratis para todos por defecto. Ejemplo futuro: SHIPPING_COST=5 y FREE_SHIPPING_THRESHOLD=50
SHIPPING_COST=0
FREE_SHIPPING_THRESHOLD=0
TAX_RATE=0.07

# --- CORS (LISTA DE ORÍGENES PERMITIDOS) ---
# Separados por coma, sin espacios. Ejemplo: http://localhost:5173,https://visualmind.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# --- PEDIDOS (opcionales) ---
# Horas que un pedido Yappy/transferencia puede quedar sin pagar antes de cancelarse
# solo y devolver el stock (contra entrega no vence).
PENDING_ORDER_HOURS=48
# Pedidos sin pagar que un mismo cliente puede tener abiertos a la vez
MAX_PENDING_ORDERS=3

# --- AVISO DE PEDIDOS NUEVOS (opcional) ---
# Bot de Telegram: créalo con @BotFather, escríbele un mensaje y obtén tu chat id en
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PROXY ---
# Número de proxies delante del servidor (Railway/Render = 1). Déjalo así salvo que sepas que hay otro.
TRUST_PROXY=1
