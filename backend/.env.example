# --- CONFIGURACIÓN DEL SERVIDOR ---
PORT=5000
# En Railway/Render usa: production
NODE_ENV=development

# --- BASE DE DATOS (POSTGRESQL) ---
# Opción 1: URL directa (Recomendado para Railway/Render)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Opción 2: Parámetros individuales (Local)
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visualmind

# --- SEGURIDAD ---
# Una cadena aleatoria larga para firmar los JWT
JWT_SECRET=tu_secreto_super_seguro_aqui

# --- ADMINISTRADOR ---
# Obligatorio en producción la primera vez (y para recuperar el acceso).
# Si solo defines ADMIN_PASSWORD, se aplica a visualmind@admin.com.
# Al arrancar, el servidor crea/actualiza este admin. Usa una contraseña fuerte.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- PRECIOS (opcionales) ---
# Envío gratis para todos por defecto. Ejemplo futuro: SHIPPING_COST=5 y FREE_SHIPPING_THRESHOLD=50
SHIPPING_COST=0
FREE_SHIPPING_THRESHOLD=0
TAX_RATE=0.07

# --- CORS (LISTA DE ORÍGENES PERMITIDOS) ---
# Separados por coma, sin espacios. Ejemplo: http://localhost:5173,https://visualmind.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
